# ==============================================================================
# FileMarket - Environment Configuration
# ==============================================================================
# All variables here are safe for browser client runtime.
# Mock fallback values are pre-wired in code so the application builds and
# previews seamlessly without crashing even when .env is absent or empty.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (Already pre-configured via firebase-applet-config.json)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 2. Active Payment Methods (Client-Safe Public Identifiers)
# ------------------------------------------------------------------------------
# Stripe Publishable Key (Safe for browser checkout)
VITE_STRIPE_PUBLISHABLE_KEY=""

# PayPal Client ID (Safe for browser PayPal SDK)
VITE_PAYPAL_CLIENT_ID=""

# Local Bangladesh Gateways (Public merchant / store identifiers)
VITE_SSLCOMMERZ_STORE_ID=""
VITE_SHURJOPAY_USERNAME=""
VITE_AAMARPAY_STORE_ID=""

# Razorpay Key ID (Safe for browser UPI / NetBank checkout)
VITE_RAZORPAY_KEY_ID=""
